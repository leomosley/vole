import { CheckBox, LineEdit, ListView, Slider, Palette } from "std-widgets.slint";

export struct ApplicationRow {
    display: string,
    executable: string,
    running: bool,
    level: int,
    muted: bool,
}
export struct HotkeyRow {
    name: string,
    shortcut: string,
    action-count: int,
    enabled: bool,
    toggle: bool,
}
export struct ActionRow {
    target: string,
    operation: int,
    value: int,
    muted: bool,
}

// Neutral system-utility theme. Follows the OS light/dark setting via the
// std-widgets Palette, with a single restrained system-blue accent.
global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Surfaces.
    out property <color> window: root.dark ? #202020 : #f3f3f3;
    out property <color> surface: root.dark ? #2b2b2b : #ffffff;
    out property <color> surface-alt: root.dark ? #333333 : #f6f6f6;
    out property <color> hover: root.dark ? #3a3a3a : #ececec;
    out property <color> selection: root.dark ? #2d3f50 : #e8f1fb;

    // Hairlines.
    out property <color> border: root.dark ? #383838 : #e2e2e2;
    out property <color> border-strong: root.dark ? #4a4a4a : #c8c8c8;

    // Text.
    out property <color> text: root.dark ? #f4f4f4 : #1a1a1a;
    out property <color> text-dim: root.dark ? #c6c6c6 : #565656;
    out property <color> text-mute: root.dark ? #949494 : #8a8a8a;

    // System-blue accent.
    out property <color> accent: root.dark ? #4cc2ff : #0067c0;
    out property <color> accent-hover: root.dark ? #63cbff : #1a75c5;
    out property <color> accent-press: root.dark ? #3aa8e0 : #005ba1;
    out property <color> accent-fg: root.dark ? #000000 : #ffffff;

    // Status colors.
    out property <color> danger: root.dark ? #ff99a4 : #c42b1c;
    out property <color> danger-bg: root.dark ? #3a2529 : #fdeeee;
    out property <color> good: root.dark ? #6ccb5f : #0f7b0f;

    // Metrics.
    out property <length> radius: 4px;
    out property <length> radius-sm: 3px;
}

component PushButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked;

    height: 28px;
    border-radius: Theme.radius;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border-strong;
    background: root.primary
        ? (ta.pressed ? Theme.accent-press : (ta.has-hover ? Theme.accent-hover : Theme.accent))
        : (ta.pressed ? Theme.hover : (ta.has-hover ? Theme.surface-alt : Theme.surface));

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            vertical-alignment: center;
            horizontal-alignment: center;
            font-size: 12px;
            font-weight: root.primary ? 600 : 400;
            color: root.primary
                ? Theme.accent-fg
                : (root.danger ? Theme.danger : Theme.text);
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.text-mute;
    in property <color> fill: Theme.surface-alt;
    horizontal-stretch: 0;
    height: 16px;
    border-radius: Theme.radius-sm;
    background: root.fill;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        Text {
            text: root.text;
            vertical-alignment: center;
            color: root.ink;
            font-size: 10px;
            font-weight: 500;
        }
    }
}

component HotkeyRecorder inherits Rectangle {
    in property <string> shortcut;
    callback captured(string, bool, bool, bool, bool);

    height: 28px;
    border-radius: Theme.radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent : Theme.border-strong;

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Control || event.text == Key.Alt || event.text == Key.Shift || event.text == Key.Meta) {
                return EventResult.accept;
            }
            root.captured(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            // Stop recording once a combination lands so the field shows the result.
            fs.clear-focus();
            return EventResult.accept;
        }
    }

    if fs.has-focus: Text {
        x: 10px;
        vertical-alignment: center;
        text: "Press a key combination…";
        color: Theme.accent;
        font-size: 12px;
    }
    if !fs.has-focus && root.shortcut == "": Text {
        x: 10px;
        vertical-alignment: center;
        text: "Click, then press keys";
        color: Theme.text-mute;
        font-size: 12px;
    }
    if !fs.has-focus && root.shortcut != "": Text {
        x: 10px;
        vertical-alignment: center;
        text: root.shortcut;
        color: Theme.text;
        font-family: "Consolas";
        font-size: 13px;
    }
    Text {
        x: parent.width - self.width - 10px;
        vertical-alignment: center;
        text: fs.has-focus ? "listening" : "edit";
        color: Theme.text-mute;
        font-size: 10px;
    }

    TouchArea {
        clicked => {
            fs.focus();
        }
    }
}

// A single row inside the inline app picker.
component PickerRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> running: false;
    in property <bool> show-dot: true;
    in property <string> trailing;
    in property <color> trailing-ink: Theme.text-mute;
    callback clicked;

    height: 36px;
    border-radius: Theme.radius;
    background: ta.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 9px;

        if root.show-dot: Rectangle {
            width: 7px;
            height: 7px;
            y: parent.height / 2 - 3.5px;
            border-radius: 3.5px;
            background: root.running ? Theme.good : Theme.border-strong;
        }
        VerticalLayout {
            alignment: center;
            spacing: 0px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 12px;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.text-mute;
                font-size: 10px;
                overflow: elide;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        if root.trailing != "": Text {
            y: parent.height / 2 - self.height / 2;
            text: root.trailing;
            color: root.trailing-ink;
            font-size: 11px;
            font-family: "Consolas";
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One choice in the operation toggle: a vector icon plus a label, filled with
// the accent color when selected.
component Segment inherits Rectangle {
    in property <int> kind;
    in property <bool> selected;
    in property <string> label;
    callback clicked;

    property <color> ink: root.selected ? Theme.accent-fg : Theme.text-dim;

    height: 26px;
    background: root.selected
        ? Theme.accent
        : (ta.has-hover ? Theme.surface-alt : transparent);

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 5px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 14px;
                height: 14px;

                // Set level: three rising bars.
                if root.kind == 0: Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    fill: root.ink;
                    commands: "M2 9 L5 9 L5 14 L2 14 Z M6.5 5 L9.5 5 L9.5 14 L6.5 14 Z M11 2 L14 2 L14 14 L11 14 Z";
                }
                // Adjust: up and down triangles.
                if root.kind == 1: Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    fill: root.ink;
                    commands: "M8 2 L12 7 L4 7 Z M8 14 L12 9 L4 9 Z";
                }
                // Mute: a speaker with a cross.
                if root.kind == 2: Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    fill: root.ink;
                    commands: "M2 6 L5 6 L9 3 L9 13 L5 10 L2 10 Z";
                }
                if root.kind == 2: Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    stroke: root.ink;
                    stroke-width: 1.5px;
                    commands: "M11 6 L14 10 M14 6 L11 10";
                }
            }
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 11px;
            font-weight: root.selected ? 600 : 400;
            color: root.selected ? Theme.accent-fg : Theme.text-dim;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Segmented switch between the three operation kinds.
component OperationToggle inherits Rectangle {
    in property <int> current;
    callback chose(int);

    height: 28px;
    border-radius: Theme.radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-strong;
    clip: true;

    HorizontalLayout {
        padding: 1px;
        Segment {
            kind: 0;
            label: "Set";
            selected: root.current == 0;
            clicked => {
                root.chose(0);
            }
        }
        Rectangle {
            width: 1px;
            background: Theme.border;
        }
        Segment {
            kind: 1;
            label: "Adjust";
            selected: root.current == 1;
            clicked => {
                root.chose(1);
            }
        }
        Rectangle {
            width: 1px;
            background: Theme.border;
        }
        Segment {
            kind: 2;
            label: "Mute";
            selected: root.current == 2;
            clicked => {
                root.chose(2);
            }
        }
    }
}

// A step in a hotkey's action list: names its target and edits its operation
// and level inline as a single dense row. The slider commits on release.
component StepCard inherits Rectangle {
    in property <int> number;
    in property <string> target;
    in property <int> operation;
    in property <int> value;
    in property <bool> muted;
    callback edited(int, float, bool);
    callback removed();

    // Local mirror of the operation so the row updates instantly on toggle,
    // before the model round-trips back through Rust.
    property <int> op: root.operation;

    height: 40px;

    VerticalLayout {
        padding-bottom: 4px;
        Rectangle {
            border-radius: Theme.radius;
            background: Theme.surface-alt;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 5px;
                spacing: 10px;

                Text {
                    text: root.number;
                    color: Theme.text-mute;
                    font-size: 11px;
                    width: 12px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                Text {
                    width: 132px;
                    text: root.target;
                    color: Theme.text;
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    OperationToggle {
                        current: root.op;
                        chose(kind) => {
                            root.op = kind;
                            if (kind == 2) {
                                root.edited(2, 0, true);
                            } else {
                                root.edited(kind, root.value, false);
                            }
                        }
                    }
                }

                // Level region: slider + readout, or the mute checkbox. Fixed
                // width so the remove button stays aligned across rows.
                Rectangle {
                    width: 168px;

                    if root.op != 2: HorizontalLayout {
                        spacing: 8px;
                        level := Slider {
                            horizontal-stretch: 1;
                            minimum: root.op == 1 ? -100 : 0;
                            maximum: 100;
                            step: 1;
                            value: root.value;
                            released(v) => {
                                root.edited(root.op, v, false);
                            }
                        }
                        Text {
                            width: 38px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            text: (root.op == 1 && level.value > 0 ? "+" : "") + round(level.value) + "%";
                            color: Theme.text-dim;
                            font-family: "Consolas";
                            font-size: 11px;
                        }
                    }

                    if root.op == 2: HorizontalLayout {
                        alignment: start;
                        CheckBox {
                            text: "Muted";
                            checked: root.muted;
                            toggled => {
                                root.edited(2, 0, self.checked);
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: Theme.radius-sm;
                        background: remove-touch.has-hover ? Theme.danger-bg : transparent;
                        Text {
                            text: "✕";
                            color: remove-touch.has-hover ? Theme.danger : Theme.text-mute;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        remove-touch := TouchArea {
                            clicked => {
                                root.removed();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Vole";
    icon: @image-url("../../../assets/vole.png");
    min-width: 820px;
    min-height: 560px;
    preferred-width: 980px;
    preferred-height: 640px;
    background: Theme.window;

    in property <[ApplicationRow]> applications;
    in property <[HotkeyRow]> hotkeys;
    in property <[ActionRow]> actions;
    in property <int> selected-hotkey: -1;
    in property <string> selected-name;
    in property <string> selected-shortcut;
    in property <bool> selected-enabled;
    in property <bool> selected-toggle;
    in property <string> status-text: "Ready";
    in property <bool> status-error: false;
    in property <bool> launch-on-startup: false;

    // UI-local state: whether the inline app picker is showing in the editor.
    property <bool> picker-open: false;

    callback search-applications(string);
    callback refresh-applications();
    callback select-hotkey(int);
    callback set-launch-on-startup(bool);
    callback add-hotkey();
    callback remove-hotkey(int);
    callback test-fire(int);
    callback update-hotkey(int, bool, bool);
    callback rename-hotkey(int, string);
    callback record-shortcut(string, bool, bool, bool, bool);
    callback add-action(string);
    callback remove-action(int, int);
    callback update-action(int, int, string, int, float, bool);

    VerticalLayout {
        padding: 0px;

        // Title bar: vole mark, wordmark, and the startup toggle.
        Rectangle {
            vertical-stretch: 0;
            height: 48px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../../assets/vole.png");
                        width: 24px;
                        height: 24px;
                        image-fit: contain;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: "Vole";
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    Text {
                        text: "Volume Output Level Executioner";
                        color: Theme.text-mute;
                        font-size: 10px;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    CheckBox {
                        text: "Launch on startup";
                        checked: root.launch-on-startup;
                        toggled => {
                            root.set-launch-on-startup(self.checked);
                        }
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 0;
            height: 1px;
            background: Theme.border;
        }

        // Transient error banner: only visible when something fails.
        if root.status-error: Rectangle {
            vertical-stretch: 0;
            background: Theme.danger-bg;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 8px;
                Text {
                    text: root.status-text;
                    color: Theme.danger;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        // Body: master-detail split.
        HorizontalLayout {
            vertical-stretch: 1;
            padding: 10px;
            spacing: 10px;

            // Left rail: the list of hotkeys (master).
            Rectangle {
                width: 240px;
                border-radius: Theme.radius;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 0px;

                    HorizontalLayout {
                        vertical-stretch: 0;
                        padding-left: 10px;
                        padding-right: 8px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Hotkeys";
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 600;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        PushButton {
                            text: "New";
                            primary: true;
                            clicked => {
                                root.add-hotkey();
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 0;
                        height: 1px;
                        background: Theme.border;
                    }

                    if root.hotkeys.length == 0: Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "No hotkeys yet";
                                color: Theme.text-dim;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Create one to get started.";
                                color: Theme.text-mute;
                                font-size: 11px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if root.hotkeys.length > 0: ListView {
                        vertical-stretch: 1;
                        for binding[index] in root.hotkeys: Rectangle {
                            height: 34px;
                            background: index == root.selected-hotkey
                                ? Theme.selection
                                : (row-touch.has-hover ? Theme.surface-alt : transparent);

                            row-touch := TouchArea {
                                clicked => {
                                    root.select-hotkey(index);
                                }
                            }

                            if index == root.selected-hotkey: Rectangle {
                                x: 0;
                                width: 3px;
                                height: parent.height;
                                background: Theme.accent;
                            }

                            HorizontalLayout {
                                padding-left: 11px;
                                padding-right: 5px;
                                spacing: 8px;
                                VerticalLayout {
                                    width: 104px;
                                    alignment: center;
                                    Text {
                                        text: binding.name;
                                        color: binding.enabled ? Theme.text : Theme.text-mute;
                                        font-size: 12px;
                                        font-weight: 500;
                                        overflow: elide;
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: binding.shortcut == "" ? "unset" : binding.shortcut;
                                        color: binding.shortcut == "" ? Theme.text-mute : Theme.text-dim;
                                        font-family: "Consolas";
                                        font-size: 11px;
                                        horizontal-alignment: right;
                                    }
                                }
                                // Reserved slot: keeps the delete button fixed whether or not the badge shows.
                                Rectangle {
                                    width: 28px;
                                    VerticalLayout {
                                        alignment: center;
                                        Badge {
                                            text: "off";
                                            ink: Theme.danger;
                                            fill: Theme.danger-bg;
                                            visible: !binding.enabled;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: Theme.radius-sm;
                                        background: delete-touch.has-hover ? Theme.danger-bg : transparent;
                                        Text {
                                            text: "✕";
                                            color: delete-touch.has-hover ? Theme.danger : Theme.text-mute;
                                            font-size: 12px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            visible: row-touch.has-hover || delete-touch.has-hover || index == root.selected-hotkey;
                                        }
                                        delete-touch := TouchArea {
                                            clicked => {
                                                root.remove-hotkey(index);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Right pane: the editor (detail).
            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.radius;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;

                // Empty state.
                if root.selected-hotkey < 0: VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 5px;
                        Text {
                            text: "Select a hotkey to edit";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Choose one on the left, or create a new hotkey to begin.";
                            color: Theme.text-mute;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        PushButton {
                            text: "New hotkey";
                            primary: true;
                            clicked => {
                                root.add-hotkey();
                            }
                        }
                    }
                }

                // Editor.
                if root.selected-hotkey >= 0: VerticalLayout {
                    padding: 12px;
                    spacing: 12px;

                    // Name + shortcut.
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            Text {
                                text: "Name";
                                color: Theme.text-dim;
                                font-size: 11px;
                                font-weight: 500;
                            }
                            name-field := LineEdit {
                                text: root.selected-name;
                                placeholder-text: "Auto-named from your steps";
                                edited(text) => {
                                    root.rename-hotkey(root.selected-hotkey, text);
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            Text {
                                text: "Shortcut";
                                color: Theme.text-dim;
                                font-size: 11px;
                                font-weight: 500;
                            }
                            HotkeyRecorder {
                                shortcut: root.selected-shortcut;
                                captured(text, ctrl, alt, shift, meta) => {
                                    root.record-shortcut(text, ctrl, alt, shift, meta);
                                }
                            }
                        }
                    }

                    // Options + actions on the hotkey itself.
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            enabled-field := CheckBox {
                                text: "Enabled";
                                checked: root.selected-enabled;
                                toggled => {
                                    root.update-hotkey(root.selected-hotkey, self.checked, toggle-field.checked);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            toggle-field := CheckBox {
                                text: "Toggle (press again to undo)";
                                checked: root.selected-toggle;
                                toggled => {
                                    root.update-hotkey(root.selected-hotkey, enabled-field.checked, self.checked);
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        PushButton {
                            text: "Test";
                            clicked => {
                                root.test-fire(root.selected-hotkey);
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 0;
                        height: 1px;
                        background: Theme.border;
                    }

                    // Actions section header + add controls.
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Steps";
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 600;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        PushButton {
                            text: "Focused app";
                            clicked => {
                                root.add-action("");
                            }
                        }
                        PushButton {
                            text: root.picker-open ? "Close list" : "Add app";
                            primary: !root.picker-open;
                            clicked => {
                                root.picker-open = !root.picker-open;
                                if (root.picker-open) {
                                    root.refresh-applications();
                                }
                            }
                        }
                    }

                    // Middle region: either the action list or the app picker.
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: Theme.radius;
                        background: Theme.window;
                        border-width: 1px;
                        border-color: Theme.border;

                        // Action list.
                        if !root.picker-open: VerticalLayout {
                            padding: 6px;

                            if root.actions.length == 0: VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: "No steps yet";
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Add an app or the focused window above.";
                                    color: Theme.text-mute;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }

                            if root.actions.length > 0: ListView {
                                for action[index] in root.actions: StepCard {
                                    number: index + 1;
                                    target: action.target;
                                    operation: action.operation;
                                    value: action.value;
                                    muted: action.muted;
                                    edited(operation, value, muted) => {
                                        root.update-action(root.selected-hotkey, index, action.target, operation, value, muted);
                                    }
                                    removed => {
                                        root.remove-action(root.selected-hotkey, index);
                                    }
                                }
                            }
                        }

                        // Inline app picker.
                        if root.picker-open: VerticalLayout {
                            padding: 8px;
                            spacing: 8px;

                            HorizontalLayout {
                                vertical-stretch: 0;
                                spacing: 8px;
                                search := LineEdit {
                                    placeholder-text: "Search applications…";
                                    edited(value) => {
                                        root.search-applications(value);
                                    }
                                }
                                PushButton {
                                    text: "Refresh";
                                    clicked => {
                                        root.refresh-applications();
                                    }
                                }
                            }

                            PickerRow {
                                title: "Focused window";
                                subtitle: "Whatever app is in front when pressed";
                                show-dot: false;
                                clicked => {
                                    root.add-action("");
                                    root.picker-open = false;
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                ListView {
                                    for app in root.applications: PickerRow {
                                        title: app.display;
                                        subtitle: app.executable;
                                        running: app.running;
                                        trailing: app.muted ? "muted" : (app.level >= 0 ? app.level + "%" : "");
                                        trailing-ink: app.muted ? Theme.danger : Theme.text-mute;
                                        clicked => {
                                            root.add-action(app.executable);
                                            root.picker-open = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
